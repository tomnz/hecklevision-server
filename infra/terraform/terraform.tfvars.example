# Copy to terraform.tfvars (gitignored) and edit. This is the single place for
# deployment-specific settings: apply.sh passes them through to Ansible.

region           = "us-west-2"
domain           = "example.com"
app_upstream     = "my-hecklevision-app.herokuapp.com"

# bootstrap.sh prints your current public IP; paste it below as /32.
allowed_ssh_cidr = "1.2.3.4/32"

# Optional overrides (uncomment to customize):
# availability_zone      = "us-west-2a"   # defaults to the region's "a" zone
# subdomains             = ["stream"]     # hostnames under `domain` on the cert
# extra_domains          = []             # FQDNs on other domains/TLDs to add to the cert
# timezone               = "UTC"
# instance_type          = "t3.medium"
# data_volume_size_gb    = 20
# image_tag              = "latest"       # "latest" = passthrough, "transcode" = multi-bitrate, "YYYY-MM-DD-no-transcode" to pin
